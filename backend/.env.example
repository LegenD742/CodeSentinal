# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me

# --- Database (Postgres running natively on your machine) ---
DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel@localhost:5432/codesentinel
SYNC_DATABASE_URL=postgresql+psycopg2://codesentinel:codesentinel@localhost:5432/codesentinel

# --- Redis / Celery (Redis running natively on your machine) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- GitHub App (only needed once you wire up a real repo webhook) ---
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github_app_private_key.pem
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_API_BASE_URL=https://api.github.com

# --- LLM (fully local via Ollama, already running on your machine) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
# Optional bigger local model for Security + Critic agents (leave blank to reuse LLM_MODEL):
LLM_MODEL_HEAVY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Risk thresholds ---
RISK_HIGH_THRESHOLD=75
RISK_MEDIUM_THRESHOLD=40
